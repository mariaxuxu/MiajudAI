# ====================================
# MiAjudAI Backend Environment Variables
# ====================================

# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ====================================
# Database (Supabase / PostgreSQL local)
# ====================================
# Supabase: set DATABASE_URL. It takes priority over the POSTGRES_* fields below.
#   Get it from Supabase → Project Settings → Database → Connection string.
#   Prefer the "Session pooler" (port 5432) — it resolves over IPv4. The direct
#   connection (db.<ref>.supabase.co) can be IPv6-only and fail on IPv4 networks.
#   Use the "Database password" (Settings → Database), not your Supabase account password.
#   Passwords with special chars (@ : / # ? % space) need URL-encoding; underscore (_) is safe.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SSL (Supabase requires it). The app turns SSL ON unless you set this to "false".
# Keep "false" for the local docker-compose Postgres (no SSL). If you fill in
# DATABASE_URL above for Supabase, delete this line or set it to "true".
POSTGRES_SSL=false

# Local docker-compose fallback (used when DATABASE_URL is empty)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=miajudai_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ====================================
# Firebase Admin SDK
# ====================================
# Download serviceAccountKey.json from Firebase Console
# Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_PRIVATE_KEY=<paste-private-key-from-serviceAccountKey-json>
FIREBASE_CLIENT_EMAIL=<firebase-admin-sdk-email>
FIREBASE_DATABASE_URL=<optional-realtime-db-url>

# ====================================
# Authentication & Security
# ====================================
JWT_SECRET=<your-super-secret-jwt-key-min-32-chars>
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=10

# ====================================
# LLM Configuration
# ====================================
# Google Gemini (free tier - chat financeiro)
GEMINI_API_KEY=<your-gemini-api-key-from-aistudio.google.com>
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (futuro)
OPENAI_API_KEY=<your-openai-api-key-sk-...>
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=1000

# Anthropic Claude (futuro)
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ====================================
# SMS Service (Twilio)
# ====================================
# Get from Twilio Console
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>

# ====================================
# Email Service (Optional)
# ====================================
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USER=<your-email>
SMTP_PASSWORD=<your-email-password>
SMTP_FROM=<from-email-address>

# ====================================
# CORS & API
# ====================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
API_BASE_URL=http://localhost:3001

# ====================================
# Frontend URLs
# ====================================
FLUTTER_APP_URL=<your-flutter-app-deep-link-schema>

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================================
# Monitoring & Logging
# ====================================
SENTRY_DSN=<optional-sentry-dsn>
LOG_FILE_PATH=./logs

# ====================================
# Feature Flags
# ====================================
FEATURE_SMS_VERIFICATION=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_LLM_CONTEXT_LEARNING=true
