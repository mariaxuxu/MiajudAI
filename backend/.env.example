# ====================================
# MiAjudAI Backend Environment Variables
# ====================================

# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ====================================
# Database (Oracle Cloud Free Tier)
# ====================================
# Get these from your Oracle Cloud account
POSTGRES_HOST=<your-oracle-cloud-db-host>
POSTGRES_PORT=5432
POSTGRES_DB=miajudai_dev
POSTGRES_USER=<your-db-username>
POSTGRES_PASSWORD=<your-db-password>

# Optional: Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ====================================
# Firebase Admin SDK
# ====================================
# Download serviceAccountKey.json from Firebase Console
# Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_PRIVATE_KEY=<paste-private-key-from-serviceAccountKey-json>
FIREBASE_CLIENT_EMAIL=<firebase-admin-sdk-email>
FIREBASE_DATABASE_URL=<optional-realtime-db-url>

# ====================================
# Authentication & Security
# ====================================
JWT_SECRET=<your-super-secret-jwt-key-min-32-chars>
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=10

# ====================================
# LLM Configuration
# ====================================
# Choose one: OPENAI or CLAUDE
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=<your-openai-api-key-sk-...>
OPENAI_MODEL=gpt-4-turbo
OPENAI_MAX_TOKENS=1000

# Anthropic Claude (alternative)
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# ====================================
# SMS Service (Twilio)
# ====================================
# Get from Twilio Console
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>

# ====================================
# Email Service (Optional)
# ====================================
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USER=<your-email>
SMTP_PASSWORD=<your-email-password>
SMTP_FROM=<from-email-address>

# ====================================
# CORS & API
# ====================================
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
API_BASE_URL=http://localhost:5000

# ====================================
# Frontend URLs
# ====================================
FLUTTER_APP_URL=<your-flutter-app-deep-link-schema>

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================================
# Monitoring & Logging
# ====================================
SENTRY_DSN=<optional-sentry-dsn>
LOG_FILE_PATH=./logs

# ====================================
# Feature Flags
# ====================================
FEATURE_SMS_VERIFICATION=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_LLM_CONTEXT_LEARNING=true
