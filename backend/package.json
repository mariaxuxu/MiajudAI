{
  "name": "miajudai-backend",
  "version": "1.0.0",
  "description": "Backend API for MiAjudAI - Intelligent Support App",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "prestart": "node scripts/setup-env.js",
    "predev": "node scripts/setup-env.js",
    "start": "node src/server.js",
    "dev": "cross-env NODE_ENV=development node --watch src/server.js",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status"
  },
  "keywords": [
    "miajudai",
    "firebase",
    "llm",
    "express",
    "postgresql"
  ],
  "author": "MiAjudAI Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.9.1",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "openai": "^4.52.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "twilio": "^4.10.0",
    "umzug": "^3.8.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
