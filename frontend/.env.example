# ====================================
# MiAjudAI Flutter App - Environment Variables
# ====================================

# API Configuration
API_BASE_URL=http://localhost:3001/api

# Firebase Configuration
# Get these from your Firebase Console
FIREBASE_PROJECT_ID=miajudai-dev
FIREBASE_WEB_API_KEY=<your-firebase-web-api-key>
FIREBASE_AUTH_DOMAIN=miajudai-dev.firebaseapp.com
FIREBASE_DATABASE_URL=https://miajudai-dev.firebaseio.com
FIREBASE_STORAGE_BUCKET=miajudai-dev.appspot.com
FIREBASE_MESSAGING_SENDER_ID=<your-messaging-sender-id>
FIREBASE_APP_ID=<your-app-id>

# Feature Flags
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_OFFLINE_MODE=true
ENABLE_ANALYTICS=true

# App Configuration
APP_ENVIRONMENT=development
LOG_LEVEL=debug
